# FinTrack configuration — copy to .env and fill values

# --- App ---
APP_SECRET=change-me-to-a-long-random-string
APP_HOST=0.0.0.0
APP_PORT=8000

# First user (created on startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Telegram bot (optional; core works without it) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# --- LLM (optional; all LLM features degrade gracefully without it) ---
# Google Gemini free tier
GEMINI_API_KEY=
# Optional fallback provider
OPENROUTER_API_KEY=

# --- Paths ---
DATABASE_URL=sqlite+aiosqlite:///./data/fintrack.db
MINI_APP_URL=
